# Cloud (optional). Without these the app runs local-only, exactly as before.
# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
#
# ONLY these two public values may ever be VITE_ variables (they are bundled into the browser):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
#
# NEVER put here (or in any VITE_ variable): service_role / sb_secret_ keys, the database
# password, the JWT secret, recovery keys, encryption passphrases. The build refuses them.
